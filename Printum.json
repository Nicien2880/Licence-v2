      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "Printum01" },
          "item": { "filter": "docker.containers.running" },
          "application": { "filter": "" },
          "functions": [],
          "options": { "showDisabledItems": false },
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 6, "color": "green" }
            ]
          }
        }
      }
    },
