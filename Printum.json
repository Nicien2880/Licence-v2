    {
      "id": 8,
      "title": "Snapshot available",
      "type": "table",
      "gridPos": { "x": 6, "y": 6, "w": 9, "h": 6 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "vmware.vm.snapshot.count" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "vmware.vm.snapshot.lastdate" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "Host" } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Snapshot count.*" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 1, "color": "red" }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": { "x": 15, "y": 6, "w": 9, "h": 6 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "net.if.in[\"ens192\"]" },
          "application": { "filter": "" },
          "functions": [ { "def": { "name": "sumSeries" }, "params": [] } ],
          "queryType": 0,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "net.if.out[\"ens192\"]" },
          "application": { "filter": "" },
          "functions": [
            { "def": { "name": "sumSeries" }, "params": [] },
            { "def": { "name": "scale" }, "params": [-1] }
          ],
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "Memory",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "docker.mem.total" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "docker.mem.utilization" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "Host" } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "utilization.*" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "gauge" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 70, "color": "yellow" },
                    { "value": 85, "color": "red" }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Disk space",
      "type": "table",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "/pfree/" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "cellOptions": { "type": "gauge" } },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 10, "color": "yellow" },
              { "value": 20, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Top hosts by CPU utilization",
      "type": "table",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        {
          "refId": "A",
          "group": { "filter": "printun_prod" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "system.cpu.util" },
          "application": { "filter": "" },
          "functions": [],
          "queryType": 0,
          "resultFormat": "time_series"
        }
      ],
      "transformations": [
        { "id": "prepareTimeSeries", "options": { "format": "multi" } }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "number" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "sparkline" } }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "title": "Prod segment",
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        { "refId": "A", "group": { "filter": "printun_prod" }, "application": { "filter": "" } }
      ],
      "options": {
        "sortProblems": "lastchange",
        "showTags": true,
        "hostsInMaintenance": false
      }
    },
    {
      "id": 14,
      "title": "Test segment",
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "${DS_ZABBIX}" },
      "targets": [
        { "refId": "A", "group": { "filter": "printun_test" }, "application": { "filter": "" } }
      ],
      "options": {
        "sortProblems": "lastchange",
        "showTags": true,
        "hostsInMaintenance": false
      }
    }
